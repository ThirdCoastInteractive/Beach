// ChartLineFragment wraps a server-rendered line/area chart.
// ChartLineFragment wraps a server-rendered line/area chart.
//
// Unlike the other fragments this one is a focusable widget, not a picture: the
// chart's client layer steps through samples on the arrow keys and announces
// each one into the live region below. So it keeps role="group", its own tab
// stop, and an instructive name — a keyboard user has to be told the keys exist.
templ ChartLineFragment(c LineChart, opts ...FigureOpt) {
	@chartFigure(c.HoverID, "chart-frag chart-frag-col", append(opts, withKind("line"))) {
		@LineChartSVG(c)
	}
}

// ChartGeoMapFragment wraps a server-rendered Equal Earth choropleth map.
templ ChartGeoMapFragment(id string, g GeoMap, opts ...FigureOpt) {
	@chartFigure(id, "chart-frag chart-frag-col", append(opts, withKind("tip"))) {
		@GeoMapSVG(g)
	}
}

// chartFigure is the accessible wrapper every chart fragment shares. With a
// Label it is a named role="img", so the whole chart announces as one thing
// with one name; without one it stays a plain <figure> holding a hidden
// graphic, which is the honest description of a decorative chart sitting in an
// already-titled card. Describe adds the screen-reader-only caption carrying
// what the chart actually shows.
templ chartFigure(id, class string, opts []FigureOpt) {
	{{ f := figureOf(opts) }}
	if f.interactive {
		@interactiveFigure(id, class, f) {
			{ children... }
		}
	} else {
		<figure
			id={ id }
			class={ class }
			if f.named() {
				role="img"
				aria-label={ f.label }
			}
		>
			{ children... }
			if f.desc != "" {
				<figcaption class="sr-only">{ f.desc }</figcaption>
			}
		</figure>
	}
}

// interactiveFigure is a chart you can operate: a focusable group, a name that
// says which keys do what, and the region its client layer announces into.
//
// role="group" rather than role="img" is the honest description — it is a thing
// with parts you move between, not a picture. The name always carries the
// keyboard hint, because a widget with a tab stop has to tell you the keys
// exist; nothing else on the page will.
//
// The announcement region ships empty and last. A live region that arrives
// holding its content is not announced (WCAG 4.1.3), and putting it after the
// caption keeps the two apart: the caption is the chart's text alternative, the
// region is the running commentary.
templ interactiveFigure(id, class string, f figureConfig) {
	<figure
		id={ id }
		class={ class + " focus-ring" }
		tabindex="0"
		role="group"
		aria-label={ interactiveChartName(ctx, f) }
		data-chart-keys={ f.kind }
	>
		{ children... }
		if f.desc != "" {
			<figcaption class="sr-only">{ f.desc }</figcaption>
		}
		<div class="sr-only" role="status" aria-live="polite"></div>
	</figure>
}
