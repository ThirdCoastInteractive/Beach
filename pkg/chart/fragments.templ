// Chart fragment templates. Each wraps a server-rendered SVG chart in
// a figure element that Datastar can merge by id.
package chart

// ChartBarFragment wraps a server-rendered horizontal bar chart.
templ ChartBarFragment(id string, c BarChart) {
	<figure id={ id } class="chart-frag">
		@BarChartSVG(c)
	</figure>
}

// ChartStackedBarFragment wraps a server-rendered stacked bar chart.
templ ChartStackedBarFragment(id string, c StackedBar) {
	<figure id={ id } class="chart-frag">
		@StackedBarSVG(c)
	</figure>
}

// ChartStackedGaugeFragment wraps a server-rendered stacked gauge.
templ ChartStackedGaugeFragment(id string, g StackedGauge) {
	<figure id={ id } class="chart-frag">
		@StackedGaugeSVG(g)
	</figure>
}

