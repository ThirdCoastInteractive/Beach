// ChartBulletBarFragment wraps a server-rendered bullet (overlapping) bar chart.
templ ChartBulletBarFragment(id string, c BulletBar) {
	<figure id={ id } class="chart-frag">
		@BulletBarSVG(c)
	</figure>
}

// ChartLineFragment wraps a server-rendered line/area chart.
templ ChartLineFragment(c LineChart) {
	<figure
		id={ c.HoverID }
		data-line-chart="1"
		tabindex="0"
		role="group"
		aria-label="Time series chart. Use left and right arrow keys to step through samples."
		class="chart-frag chart-frag-col focus-ring"
	>
		@LineChartSVG(c)
		<div class="sr-only" role="status" aria-live="polite"></div>
	</figure>
}

// ChartGeoMapFragment wraps a server-rendered Equal Earth choropleth map.
templ ChartGeoMapFragment(id string, g GeoMap) {
	<figure id={ id } class="chart-frag chart-frag-col">
		@GeoMapSVG(g)
	</figure>
}
