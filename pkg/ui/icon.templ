package ui

import (
	"sort"
	"sync"
)

// The icon API is ui.Icon(name, opts...). It renders an icon-font glyph and,
// as a side effect of rendering, records the glyph name so a build-time pass
// can subset the shipped font to exactly the glyphs the code references — the
// font contains only what ui.Icon actually names.
//
// Rendering is markup-and-CSS only: an <i> with a class the stylesheet maps to
// a font glyph, plus tokenized options (spin animation, size). No script.

// Size is the icon size step. It mirrors the component-level size vocabulary
// without importing the component package.
type Size string

const (
	SizeSm Size = "sm"
	SizeMd Size = ""
	SizeLg Size = "lg"
)

// IconOpt configures a single icon. Options are applied to an iconConfig.
type IconOpt func(*iconConfig)

type iconConfig struct {
	spin bool
	size Size
	// label sets an accessible name; empty renders the icon aria-hidden.
	label string
}

// Spin animates the icon with the animation tokens (e.g. a loading gear). It
// is a presentational state, so it stays pure CSS.
func Spin(c *iconConfig) { c.spin = true }

// IconSize sets the icon's size step.
func IconSize(s Size) IconOpt { return func(c *iconConfig) { c.size = s } }

// IconLabel gives the icon an accessible name. Without it the icon renders
// aria-hidden (decorative), which is correct when adjacent text already labels
// it (e.g. inside a Button).
func IconLabel(label string) IconOpt { return func(c *iconConfig) { c.label = label } }

var (
	iconMu   sync.Mutex
	iconUsed = map[string]struct{}{}
)

// recordIcon notes that name is referenced so the subsetter keeps its glyph.
func recordIcon(name string) {
	iconMu.Lock()
	iconUsed[name] = struct{}{}
	iconMu.Unlock()
}

// UsedIcons returns the sorted set of icon names referenced by ui.Icon so far.
// The build-time font-subsetting pass reads this to ship only the needed glyphs.
func UsedIcons() []string {
	iconMu.Lock()
	out := make([]string, 0, len(iconUsed))
	for n := range iconUsed {
		out = append(out, n)
	}
	iconMu.Unlock()
	sort.Strings(out)
	return out
}

// iconClass resolves the option set into the final class list and accessible
// label, recording the glyph for the font subsetter. Color, size, and the spin
// animation come from design tokens via the icon classes; nothing is hardcoded.
func iconClass(name string, opts []IconOpt) (class, label string) {
	recordIcon(name)
	cfg := iconConfig{}
	for _, o := range opts {
		o(&cfg)
	}
	class = "icon icon-" + name
	if cfg.spin {
		class += " icon-spin"
	}
	if cfg.size != "" {
		class += " icon-" + string(cfg.size)
	}
	return class, cfg.label
}

// Icon renders an icon glyph by name with optional modifiers, e.g.
//
//	@ui.Icon("gear", ui.Spin)
templ Icon(name string, opts ...IconOpt) {
	{{ class, label := iconClass(name, opts) }}
	if label != "" {
		<i class={ class } role="img" aria-label={ label }></i>
	} else {
		<i class={ class } aria-hidden="true"></i>
	}
}
