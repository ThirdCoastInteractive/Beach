// The terms page and the two legal checkboxes. The page is plain words in the
// hush voice; the checkboxes are the operative part — both are enforced
// server-side and recorded (agreements.go), the labels just tell the truth
// about what checking them means.
package web

// agreeBox is the 18+/terms checkbox the three signup doors share. Required
// client-side AND server-side (agreed + recordAgreement) — the HTML attribute
// is a courtesy, the handler is the rule.
templ agreeBox() {
	<label class="hush-agree">
		<input type="checkbox" name="agree18" required/>
		<span>i am 18 or older and i accept the <a class="hush-link" href="/terms" target="_blank">terms</a>.</span>
	</label>
}

// certBox2257 is the certification that rides every image upload — the wall
// form and the camera page both carry it. id'd so camera.js can read it.
templ certBox2257(id string) {
	<label class="hush-agree">
		<input type="checkbox" id={ id } name="cert2257" required/>
		<span>i certify under 18 U.S.C. § 2257 that every person depicted is 18 or older, and that i am the producer of this image or hold the records proving it. see the <a class="hush-link" href="/terms" target="_blank">terms</a>.</span>
	</label>
}

// termsPage is /terms: the rules of the wall, written the way the wall talks.
// Short sentences, no legalese it doesn't need, and the legally load-bearing
// parts (18+, the license, zero tolerance, section 2257, what we keep) intact
// underneath the voice. contact is the operator address (HUSH_ADMIN_EMAIL),
// shown when set.
templ termsPage(contact string) {
	@shell("goldgirl — terms") {
		<div class="hush-top hush-terms">
			<header class="hush-head">
				<h1 class="hush-title"><a class="hush-home" href="/">goldgirl</a></h1>
				<p class="hush-sub">terms of service</p>
			</header>
			<section class="hush-terms-body">
				<h2>1. what this is</h2>
				<p>goldgirl is an invite-only wall. you post to it; some of it stays. using it means you agree to what follows.</p>
				<h2>2. age</h2>
				<p>you must be <strong>18 or older</strong> to hold an account or to post, vote, or flag anything. checking the box is your statement that you are. accounts found to belong to anyone under 18 are closed, and their content removed.</p>
				<h2>3. accounts</h2>
				<p>accounts come by application, by an open seat, or by invite, and an inviter vouches for who they bring. we may close any account at any time, without notice or explanation. the wall is anonymous to other members. it is not anonymous to us; see section 7.</p>
				<h2>4. your work</h2>
				<p>your posts remain yours. by posting you allow us to store, display, and resize them to operate the wall. post only what you hold the rights to.</p>
				<h2>5. limits</h2>
				<p>nothing unlawful. nothing sexual involving anyone under 18. <strong>such material is preserved and reported to the national center for missing &amp; exploited children and to law enforcement, without exception.</strong> no doxxing, no threats, no spam. any post may be removed at our discretion.</p>
				<h2>6. images</h2>
				<p>every image carries a certification, which we retain: that each person depicted was 18 or older when the image was made, and that you produced it or hold the records required by 18 U.S.C. § 2257 and 28 C.F.R. part 75. do not upload an image you cannot stand behind.</p>
				<h2>7. what we keep</h2>
				<p>the wall displays no names and no counts. we retain, for operating the service and for legal compliance, the ip address, approximate location, and browser recorded with each post, vote, flag, signup, and certification; your email address if you provide one; and usage analytics. we disclose these records when the law requires it. we do not sell them.</p>
				<h2>8. no warranty</h2>
				<p>the wall is provided as is, without warranty of any kind. we are not liable for any loss arising from its use, including lost posts, standing, or access. we may change these terms or discontinue the wall at any time; continued use is acceptance. sections 4 through 7 survive the end of your account.</p>
				if contact != "" {
					<h2>9. contact</h2>
					<p>the operator can be reached at { contact }.</p>
				}
			</section>
			@backToWall()
		</div>
	}
}
