// The admin analytics views: a nothenry-style dashboard — KPI strip, area
// charts, ranked bars, then the two tables. Charts ride pkg/chart + chart.js
// (crosshair/tooltips); the cards are goldgirl spa, not the dark dash-widget.
package web

import (
	"strconv"

	"github.com/ThirdCoastInteractive/the-beach/cmd/hush/internal/analytics"
	"github.com/ThirdCoastInteractive/the-beach/pkg/ui"
)

templ analyticsView(handle string, admin bool, tier int, kpis analytics.KPIs) {
	@shell("goldgirl — analytics") {
		@accountStrip(handle, admin, tier)
		<div class="hush-top hush-anl">
			<header class="hush-head">
				<h1 class="hush-title">goldgirl</h1>
				<p class="hush-sub">analytics — admin eyes only.</p>
			</header>
			@backToWall()
			<div class="hush-kpi">
				@kpiCard("events", kpis.Events14, "last 14 days")
				@kpiCard("posts", kpis.Posts14, "last 14 days")
				@kpiCard("votes", kpis.Votes14, "last 14 days")
				@kpiCard("ips", kpis.IPs30, "last 30 days")
			</div>
			<div class="hush-anl-grid">
				@anlCard("events", "per day, last 14 days", "anl-events", "/admin/analytics/events", "18rem", true)
				@anlCard("posts", "text, image, layout — last 14 days", "anl-posts", "/admin/analytics/posts", "16rem", false)
				@anlCard("votes", "up vs down — last 14 days", "anl-votes", "/admin/analytics/votes", "16rem", false)
				@anlCard("countries", "top sources, last 30 days", "anl-countries", "/admin/analytics/countries", "16rem", false)
				@anlCard("ips", "top sources, last 30 days", "anl-ips", "/admin/analytics/ips", "22rem", false)
				@anlCard("recent", "last 100 events", "anl-recent", "/admin/analytics/recent", "22rem", true)
			</div>
		</div>
	}
}

templ kpiCard(label string, n uint64, sub string) {
	<div class="hush-kpi-card">
		<div class="hush-kpi-n">{ strconv.FormatUint(n, 10) }</div>
		<div class="hush-kpi-label">{ label }</div>
		<div class="hush-kpi-sub">{ sub }</div>
	</div>
}

templ anlCard(title, subtitle, id, src, height string, wide bool) {
	<article class={ "hush-anl-card", templ.KV("hush-anl-card--wide", wide) }>
		<header class="hush-anl-card-head">
			<h2 class="hush-anl-card-title">{ title }</h2>
			<p class="hush-anl-card-sub">{ subtitle }</p>
		</header>
		<div class="hush-anl-card-body" style={ "height:" + height }>
			@ui.Defer(ui.DeferProps{ID: id, Get: src, Height: "100%"})
		</div>
	</article>
}

templ ipsTable(rows []analytics.LabelCount) {
	<div id="anl-ips" class="hush-anl-scroll">
		<table class="hush-anl-table">
			<thead>
				<tr><th>ip</th><th class="hush-anl-num">events</th></tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td>{ r.L }</td>
						<td class="hush-anl-num">{ strconv.FormatUint(r.N, 10) }</td>
					</tr>
				}
				if len(rows) == 0 {
					<tr><td colspan="2" class="hush-anl-empty">nothing yet.</td></tr>
				}
			</tbody>
		</table>
	</div>
}

templ recentTable(rows []analytics.RecentEvent) {
	<div id="anl-recent" class="hush-anl-scroll">
		<table class="hush-anl-table">
			<thead>
				<tr><th>ts</th><th>kind</th><th>handle</th><th class="hush-anl-num">post</th><th>ip</th><th>country</th><th>path</th></tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td>{ r.TS.Format("Jan 2 15:04:05") }</td>
						<td>{ r.Kind }</td>
						<td>{ r.Handle }</td>
						<td class="hush-anl-num">
							if r.PostID != 0 {
								{ strconv.FormatInt(r.PostID, 10) }
							}
						</td>
						<td>{ r.IP }</td>
						<td>{ r.Country }</td>
						<td>{ r.Path }</td>
					</tr>
				}
				if len(rows) == 0 {
					<tr><td colspan="7" class="hush-anl-empty">nothing yet.</td></tr>
				}
			</tbody>
		</table>
	</div>
}
