// The wall: the shared pinboard of prints and the composer above it.
package web

import (
	"strconv"

	"github.com/ThirdCoastInteractive/the-beach/cmd/hush/internal/content"
	"github.com/ThirdCoastInteractive/the-beach/cmd/hush/internal/store"
)

// homePage is the wall: the centered header + composer, then the full-bleed
// pinboard. Prints are real links — opening a post is a navigation (the
// browser owns push/pop state), and the cross-document View Transition morphs
// the clicked print into its feed card. Members can drag prints around the
// board (BYOL). A method on *app — like every view that renders post images —
// so it can resolve each post's image source through the media helpers.
templ (a *App) homePage(posts []store.Post, handle string, canPost bool, admin bool, tier int, openLeft int, notice string) {
	@shell("goldgirl") {
		@accountStrip(handle, admin, tier)
		<div class="hush-top">
			<header class="hush-head">
				<h1 class="hush-title"><a class="hush-home" href="/">goldgirl</a></h1>
				<p class="hush-sub">a quiet wall — arrange it.</p>
			</header>
			if canPost {
				@composer(notice)
			} else if openLeft > 0 {
				<p class="hush-sub hush-gateline">{ strconv.Itoa(openLeft) + " seats open — " }<a class="hush-link" href="/apply">claim one</a> or <a class="hush-link" href="/login">sign in</a>.</p>
			} else {
				<p class="hush-sub hush-gateline">posting is invite-only — <a class="hush-link" href="/apply">apply</a> or <a class="hush-link" href="/login">sign in</a>.</p>
			}
		</div>
		@a.board(posts, canPost)
		<p class="hush-foot"><a class="hush-link" href="/terms">terms</a></p>
	}
}

// composer is the post box: a textarea bound to the `body` signal and a post
// button that fires @post('/posts'). No <form> — a bare button avoids needing
// a submit-prevent modifier, and Datastar carries the signal as JSON. The
// image upload below it IS a plain multipart form (303 back to the wall) — no
// Datastar, no inline script, CSP-clean; the camera island adds the
// fetch-based prepend path.
templ composer(notice string) {
	<div class="hush-compose">
		<textarea id="hush-body" name="body" class="hush-input" data-bind:body aria-label="compose a post" placeholder="say something — **bold**, *italics*, - lists"></textarea>
		<div class="hush-compose-row">
			<span class="hush-hint">bold · italics · lists · 512 characters</span>
			<button class="hush-post" data-on:click="@post('/posts')">post</button>
		</div>
		<div id="hush-note" class="hush-note" aria-live="polite">{ notice }</div>
		<form class="hush-upload" method="post" action="/upload" enctype="multipart/form-data">
			<div class="hush-upload-row">
				// required does double duty: the form can't submit empty, and
				// :valid flips only once a file is chosen — which is what shows
				// the certification below (the :has rule in hush.css)
				<input type="file" id="hush-image" name="image" accept="image/*" class="hush-file" required/>
				<button class="hush-post hush-post--ghost" type="submit">upload image</button>
				<a class="hush-link hush-cam-link" href="/studio">or arrange a layout →</a>
				<a class="hush-link" href="/compose">camera</a>
			</div>
			@certBox2257("hush-2257")
		</form>
	</div>
}

// board is the shared pinboard. It doubles as the fragment the home handler
// patches on a Datastar request. Live boards load board.js so members can
// drag and rotate prints; everyone else just looks.
templ (a *App) board(posts []store.Post, canPin bool) {
	if canPin {
		<div id="hush-board" class="hush-board hush-board--live" data-can-pin="1">
			for _, p := range posts {
				@a.print(p)
			}
		</div>
		<script type="module" src="/static/js/board.js"></script>
	} else {
		<div id="hush-board" class="hush-board">
			for _, p := range posts {
				@a.print(p)
			}
		</div>
	}
}

// print is one physical object on the board — a real link to the post's feed
// page. data-vt only becomes a live view-transition-name while the print
// holds focus, so leaving the wall morphs exactly this one. Layout prints
// render their studio collage; image and text prints are a single face.
templ (a *App) print(p store.Post) {
	<a class={ "hush-print hush-print--" + p.Kind } style={ content.PrintStyle(p, content.PinOf(p)) } data-vt={ content.VTName(p) } data-id={ strconv.FormatInt(p.ID, 10) } href={ content.PostHref(p.ID) }>
		<div class="hush-print-face">
			@a.printFace(p)
		</div>
	</a>
}

// printFace is the front of a print: a collage, a single image, or a text
// square on its computed color.
templ (a *App) printFace(p store.Post) {
	if p.Kind == "layout" {
		@a.collage(content.LayoutOf(p), true)
	} else if p.Kind == "image" {
		<img src={ a.media.PostThumbURL(p) } alt="" loading="lazy"/>
	} else {
		<div class="hush-print-text" style={ content.TileBG(p) }>
			<div class="hush-tile-body">
				@templ.Raw(p.BodyHTML)
			</div>
		</div>
	}
}

// collage paints a studio layout into a square. thumb picks the Cloudflare
// square-crop variant (wall prints); the feed uses the full-size source.
templ (a *App) collage(l content.Layout, thumb bool) {
	<div class="hush-collage">
		for _, piece := range l.Pieces {
			<img class="hush-collage-piece" src={ a.pieceURL(piece, thumb) } style={ piece.CSS() } alt="" loading="lazy"/>
		}
	</div>
}
