// The BYOL studio — a fixed square of footage and the prints you put on it.
package web

// studioPage is /studio: the client island that uploads pieces and lets the
// member drag/rotate/resize them on a square canvas, then publishes one
// layout post. studio.js owns the interaction; this page is the host.
templ studioPage(notice string) {
	@shell("goldgirl — studio") {
		<div class="hush-top">
			<header class="hush-head">
				<h1 class="hush-title">goldgirl</h1>
				<p class="hush-sub">bring your own layout — one square. put the pictures where you want them.</p>
			</header>
		</div>
		<div class="hush-studio">
			<div id="studio-board" class="studio-board" aria-label="layout canvas"></div>
			<div id="studio-tools" class="studio-tools" hidden>
				<button type="button" class="studio-tool" data-act="rot-ccw" title="rotate left 15°">↺</button>
				<button type="button" class="studio-tool" data-act="rot-cw" title="rotate right 15°">↻</button>
				<button type="button" class="studio-tool" data-act="rot-90" title="turn 90°">90°</button>
				<span id="studio-deg" class="studio-deg">0°</span>
				<span class="studio-tools-sep"></span>
				<button type="button" class="studio-tool" data-act="smaller" title="smaller">−</button>
				<button type="button" class="studio-tool" data-act="bigger" title="bigger">+</button>
				<span class="studio-tools-sep"></span>
				<button type="button" class="studio-tool" data-act="back" title="send to back">back</button>
				<button type="button" class="studio-tool" data-act="front" title="bring to front">front</button>
				<span class="studio-tools-sep"></span>
				<button type="button" class="studio-tool studio-tool--kill" data-act="kill">remove</button>
			</div>
			<p class="studio-hint">click a print · gold knob spins · corners scale · −/+ size · back/front stacks · ←→ rotate · ↑↓ scale · [ ] order</p>
			@certBox2257("studio-2257")
			<div class="studio-bar">
				<label class="cam-pick" for="studio-files">add images</label>
				<input type="file" id="studio-files" class="cam-file" accept="image/*" multiple/>
				<span id="studio-meter" class="studio-meter">0 / 8</span>
				<button id="studio-publish" class="hush-post" type="button">publish</button>
			</div>
			<p id="studio-status" class="cam-status" aria-live="polite">{ notice }</p>
		</div>
		@backToWall()
		<script type="module" src="/static/js/studio.js"></script>
	}
}
