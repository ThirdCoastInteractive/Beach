# Copy to .env (or export) to turn on askmuskie's game features (accounts, chat,
# stats, leaderboard). Leave DATABASE_URL unset to run the anonymous pond only.
PORT=8099
# Matches docker-compose.yml (host port 5439):
DATABASE_URL=postgres://askmuskie:askmuskie@localhost:5439/askmuskie
# Set RELEASE=1 in production (flips the session cookie Secure flag).
# RELEASE=1

# Optional LLM oracle (an Ollama sidecar) — leave unset for flat-file wisdom.
# Use a STOCK small model (≤4GB), e.g. qwen3:4b or gemma3:4b. With these set, the
# Muskie's lines are generated from live tank state + (logged-in) visitor messages.
# MUSKIE_LLM_URL=http://localhost:11434
# MUSKIE_LLM_MODEL=qwen3:4b
