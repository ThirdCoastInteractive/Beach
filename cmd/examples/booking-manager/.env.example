# booking-manager — copy to .env for local runs (`go run ./cmd/examples/booking-manager`).
#
# Postgres is the only requirement; the binary exits with the missing list if
# DATABASE_URL is unset. This points at a LOCAL Postgres (e.g. one you ran
# with a published port); `docker compose up` sets its own service-name value.
PORT=8080
DATABASE_URL=postgres://beach:beach@localhost:5432/booking?sslmode=disable

# Guest messaging is optional: unset, mail and texts "deliver" to the log.
# Strongest configured transport wins (Mailgun > SMTP > log; Twilio > log).
#MAIL_FROM_NAME=Loon Lake Rentals
#MAIL_FROM_ADDR=stay@example.com
#MAILGUN_KEY=
#MAILGUN_DOMAIN=
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMS_FROM_NUMBER=+15550001111
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_MESSAGING_SERVICE_SID=
