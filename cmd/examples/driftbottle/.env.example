# driftbottle — copy to .env for local runs (`go run ./cmd/examples/driftbottle`).
#
# The live matchmaking and feed are in-memory (the fan-out hot path), but
# persistence and analytics are REQUIRED to boot — there is no ephemeral/no-DB
# mode. Both DSNs below must be set or the process aborts at startup with the
# list of what is missing:
#
#   - DATABASE_URL (or POSTGRES_DSN) — Postgres transcript archive
#   - CLICKHOUSE_DSN                 — ClickHouse event firehose (/stats)
#
# For `go run`, point these at a local Postgres + ClickHouse. Under docker
# compose these are set from the internal service names instead (see
# docker-compose.yml); this file's PORT drives the host port mapping there.
PORT=8080
DATABASE_URL=postgres://beach:beach@localhost:5432/driftbottle?sslmode=disable
CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/driftbottle
