# pantry — copy to .env for local runs (`go run ./cmd/examples/pantry`).
#
# pantry requires the full Beach stack: Postgres (inventory, auth, sessions) and
# ClickHouse (the dashboard's activity firehose). Both DSNs are required — the
# binary exits with the missing list if either is unset. These point at a LOCAL
# Postgres/ClickHouse (e.g. ones you ran with published ports); `docker compose
# up` sets its own service-name values and does not read this file.
PORT=8080
DATABASE_URL=postgres://beach:beach@localhost:5432/pantry?sslmode=disable
CLICKHOUSE_DSN=clickhouse://beach:beach@localhost:9000/beach
