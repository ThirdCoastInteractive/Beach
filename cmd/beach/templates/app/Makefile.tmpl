# {{.App}} — the-beach app Makefile.
#
# The verification pipeline is framework doctrine: `make gen` -> `make vet` ->
# `make up` -> browser check. A task is not done until every step passes.

APP := {{.App}}
BIN := bin/$(APP)

# beach is this checkout's scaffold CLI, resolved through the local `replace` in
# go.mod, so `make gen` runs it without a network fetch. stellar/sqlc are looked
# up on PATH and are no-ops (warn-and-continue) when absent, so `make gen` never
# hard-fails a fresh clone.
BEACH := go run github.com/ThirdCoastInteractive/the-beach/cmd/beach

.DEFAULT_GOAL := help

.PHONY: help gen vet up down start-db stop-db build

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'

gen: ## Regenerate CSS (stellar), DB code + apigen (sqlc), components (beach ecs gen)
	@command -v stellar >/dev/null 2>&1 && stellar build || echo "skip: stellar not on PATH"
	@command -v sqlc    >/dev/null 2>&1 && sqlc generate || echo "skip: sqlc not on PATH"
	@test -f components.beach.yaml && $(BEACH) ecs gen || echo "skip: no components.beach.yaml"

vet: gen ## Run gen then go vet
	go vet ./...

build: ## Compile the app binary
	go build -o $(BIN) .

up: build ## Build and run the app (PORT defaults to 8080)
	$(BIN)

down: ## Stop the app (placeholder; the dev binary stops on Ctrl-C)
	@echo "stop the running $(APP) process (Ctrl-C in its terminal)"

start-db: ## Start Postgres via docker-compose
	docker compose up -d db

stop-db: ## Stop Postgres. NEVER rm the db volume to "fix" a migration — fix the migration.
	docker compose stop db
