# {{.App}} environment template. Copy to `.env` and adjust.
# The skeleton boots with none of these set — they wire in the database lane.

# HTTP bind port (the app reads PORT; default 8080).
PORT=8080

# Postgres DSN — matches docker-compose.yml. Leave unset to run database-less.
DATABASE_URL=postgres://{{.App}}:{{.App}}@localhost:5432/{{.App}}?sslmode=disable

# ClickHouse DSN — optional. Unset means no analytics lane; the app still boots.
# CLICKHOUSE_URL=clickhouse://{{.App}}:{{.App}}@localhost:9000/{{.App}}

# Default locale for the i18n runtime.
LOCALE=en-US
