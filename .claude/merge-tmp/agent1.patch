+/* ── flagging — the quiet report control on a focused card. dim text in the
+   meta line, no counts; clicked once it reads "flagged" and goes inert. a
+   post the flags take down collapses to the one-line hushed notice. ──────── */
+.hush-card-meta--focused {
+  display: flex;
+  align-items: baseline;
+  gap: 1rem;
+}
+.hush-flag {
+  margin-left: auto;
+  padding: 0;
+  font: inherit;
+  font-size: 0.75rem;
+  text-transform: lowercase;
+  color: rgba(255, 255, 255, 0.3);
+  background: transparent;
+  border: 0;
+  cursor: pointer;
+}
+button.hush-flag:hover { color: rgba(255, 255, 255, 0.7); }
+.hush-flag--done { cursor: default; }
+.hush-hushed {
+  padding: 2.5rem 0;
+  text-align: center;
+  color: rgba(255, 255, 255, 0.45);
+}
+
 /* the invite panel (your own profile, tier 1+) */
 .hush-invites {
   max-width: 420px;
@@ -480,3 +507,116 @@ html:active-view-transition-type(backwards)::view-transition-old(root) {
