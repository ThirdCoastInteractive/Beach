diff --git a/examples/hush/admin.go b/examples/hush/admin.go
new file mode 100644
index 0000000..d4da1c2
--- /dev/null
+++ b/examples/hush/admin.go
@@ -0,0 +1,324 @@
+// The admin suite — the pages with eyes. Everything the member-facing wall
+// refuses to print (scores, tiers, chains, vote counts, IPs, geo, user
+// agents) is laid out here, behind app.Can("admin"): the hub (/admin), the
+// moderation review (/admin/review), the everything browser (/admin/posts),
+// and the member ledger (/admin/members). The views live in adminviews.templ.
+// All of these read across hush's Postgres tables, so without a database they
+// degrade to a notice, like /admin/queue.
+package main
+
+import (
+	"html"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+
+	beach "github.com/ThirdCoastInteractive/the-beach"
+)
+
+// adminStats is the hub's quick read: what needs attention, and how big the
+// place has gotten.
+type adminStats struct {
+	Pending int // applications awaiting a decision
+	Flagged int // posts hidden or carrying flags
+	Posts   int
+	Members int
+}
+
+// adminHub is /admin: the four numbers and the way into each section.
+func (a *app) adminHub(c *beach.Ctx) (beach.View, error) {
+	if a.pool == nil {
+		return beach.View{Page: noticePage("admin needs the database.", "set DATABASE_URL to enable the gate.")}, nil
+	}
+	ctx := c.Context()
+	var st adminStats
+	_ = a.pool.QueryRow(ctx, `SELECT count(*) FROM hush_applications WHERE status = 'pending'`).Scan(&st.Pending)
+	_ = a.pool.QueryRow(ctx,
+		`SELECT count(DISTINCT p.id) FROM hush_posts p
+		 LEFT JOIN hush_flags f ON f.post_id = p.id
+		 WHERE p.hidden_at IS NOT NULL OR f.post_id IS NOT NULL`).Scan(&st.Flagged)
+	_ = a.pool.QueryRow(ctx, `SELECT count(*) FROM hush_posts`).Scan(&st.Posts)
+	_ = a.pool.QueryRow(ctx, `SELECT count(*) FROM users`).Scan(&st.Members)
+	return beach.View{Page: adminHubPage(st)}, nil
+}
+
+// flagRow is one recorded flag as the review page lists it: who flagged, and
+// the tier they held at flag time — what the hiding rules actually weighed.
+type flagRow struct {
+	Flagger string
+	Tier    int
+}
+
+// adminReview is the moderation queue: every hidden or flagged post in full —
+// the wall's flagged read, plus who flagged each one out of hush_flags.
+func (a *app) adminReview(c *beach.Ctx) (beach.View, error) {
+	if a.pool == nil {
+		return beach.View{Page: noticePage("review needs the database.", "set DATABASE_URL to enable the gate.")}, nil
+	}
+	ctx := c.Context()
+	posts := a.store.flagged(ctx)
+	flaggers := map[int64][]flagRow{}
+	if rows, err := a.pool.Query(ctx,
+		`SELECT post_id, flagger, flagger_tier FROM hush_flags ORDER BY created_at`); err == nil {
+		defer rows.Close()
+		for rows.Next() {
+			var id int64
+			var fr flagRow
+			if rows.Scan(&id, &fr.Flagger, &fr.Tier) == nil {
+				flaggers[id] = append(flaggers[id], fr)
+			}
+		}
+	}
+	return beach.View{Page: adminReviewPage(posts, flaggers)}, nil
+}
+
+// adminPostsLimit caps the everything browser at the newest rows — dense, not
+// exhaustive; the filters narrow within that window.
+const adminPostsLimit = 500
+
+// voteCount is one post's tallied reactions — numbers members never see.
+type voteCount struct{ Up, Down int }
+
+// adminPosts is the everything browser: every post including hidden ones,
+// newest-first, with optional exact-match ?author= and ?ip= filters applied
+// here in the handler (the store read stays one shape).
+func (a *app) adminPosts(c *beach.Ctx) (beach.View, error) {
+	if a.pool == nil {
+		return beach.View{Page: noticePage("the post browser needs the database.", "set DATABASE_URL to enable the gate.")}, nil
+	}
+	ctx := c.Context()
+	author := strings.TrimSpace(c.Query("author"))
+	ip := strings.TrimSpace(c.Query("ip"))
+	posts := a.store.adminList(ctx, adminPostsLimit)
+	if author != "" || ip != "" {
+		filtered := make([]Post, 0, len(posts))
+		for _, p := range posts {
+			if author != "" && p.Author != author {
+				continue
+			}
+			if ip != "" && p.Meta.IP != ip {
+				continue
+			}
+			filtered = append(filtered, p)
+		}
+		posts = filtered
+	}
+	// reaction tallies per post — the tolerant read style: errors mean zeros
+	votes := map[int64]voteCount{}
+	if rows, err := a.pool.Query(ctx,
+		`SELECT post_id,
+		        count(*) FILTER (WHERE weight > 0),
+		        count(*) FILTER (WHERE weight < 0)
+		 FROM hush_reactions GROUP BY post_id`); err == nil {
+		defer rows.Close()
+		for rows.Next() {
+			var id int64
+			var v voteCount
+			if rows.Scan(&id, &v.Up, &v.Down) == nil {
+				votes[id] = v
+			}
+		}
+	}
+	return beach.View{Page: adminPostsPage(posts, votes, author, ip)}, nil
+}
+
+// memberRow is one account as the ledger lists it: the roles and the real
+// numbers (score, tier, chain) the rest of hush works so hard never to print.
+type memberRow struct {
+	Handle   string
+	Roles    string
+	Score    float64
+	Tier     int
+	Chain    float64
+	Posts    int
+	Email    string // "" when hush_member_emails has no row
+	Verified bool
+	Minted   int // invites minted
+	Used     int // ...of which redeemed
+	LastIP   string
+}
+
+// adminMembers is the member ledger: every account joined against its roles
+// and optional email, then filled in from the per-author aggregates (posts,
+// last-seen IP, invites) and the in-memory Repute scores.
+func (a *app) adminMembers(c *beach.Ctx) (beach.View, error) {
+	if a.pool == nil {
+		return beach.View{Page: noticePage("the member ledger needs the database.", "set DATABASE_URL to enable the gate.")}, nil
+	}
+	ctx := c.Context()
+	rows, err := a.pool.Query(ctx,
+		`SELECT u.username,
+		        coalesce(string_agg(DISTINCT r.slug, ' '), ''),
+		        coalesce(max(e.email), ''),
+		        bool_or(e.verified_at IS NOT NULL)
+		 FROM users u
+		 LEFT JOIN user_roles ur ON ur.user_id = u.id
+		 LEFT JOIN roles r ON r.id = ur.role_id
+		 LEFT JOIN hush_member_emails e ON e.user_id = u.id
+		 GROUP BY u.id ORDER BY u.id`)
+	if err != nil {
+		return beach.View{}, err
+	}
+	defer rows.Close()
+	var members []memberRow
+	for rows.Next() {
+		var m memberRow
+		if err := rows.Scan(&m.Handle, &m.Roles, &m.Email, &m.Verified); err != nil {
+			return beach.View{}, err
+		}
+		members = append(members, m)
+	}
+	if err := rows.Err(); err != nil {
+		return beach.View{}, err
+	}
+
+	// the per-author aggregates, tolerant reads into maps
+	postCounts := map[string]int{}
+	if rows, err := a.pool.Query(ctx,
+		`SELECT author, count(*) FROM hush_posts WHERE author <> '' GROUP BY author`); err == nil {
+		defer rows.Close()
+		for rows.Next() {
+			var h string
+			var n int
+			if rows.Scan(&h, &n) == nil {
+				postCounts[h] = n
+			}
+		}
+	}
+	lastIPs := map[string]string{}
+	if rows, err := a.pool.Query(ctx,
+		`SELECT DISTINCT ON (author) author, ip FROM hush_posts WHERE author <> '' ORDER BY author, id DESC`); err == nil {
+		defer rows.Close()
+		for rows.Next() {
+			var h, ip string
+			if rows.Scan(&h, &ip) == nil {
+				lastIPs[h] = ip
+			}
+		}
+	}
+	type tally struct{ minted, used int }
+	invites := map[string]tally{}
+	if rows, err := a.pool.Query(ctx,
+		`SELECT inviter, count(*), count(used_by) FROM hush_invites GROUP BY inviter`); err == nil {
+		defer rows.Close()
+		for rows.Next() {
+			var h string
+			var t tally
+			if rows.Scan(&h, &t.minted, &t.used) == nil {
+				invites[h] = t
+			}
+		}
+	}
+
+	for i := range members {
+		h := members[i].Handle
+		members[i].Score = a.rep.score(h)
+		members[i].Tier = a.tierOf(members[i].Score)
+		members[i].Chain = a.rep.chainScore(h)
+		members[i].Posts = postCounts[h]
+		members[i].LastIP = lastIPs[h]
+		members[i].Minted, members[i].Used = invites[h].minted, invites[h].used
+	}
+	return beach.View{Page: adminMembersPage(members)}, nil
+}
+
+// doModerate applies one admin ruling to a post — hide, restore, or purge —
+// then 303s back to the page that asked (review, or the post browser with its
+// filters intact). Anything outside /admin falls back to review, so the form
+// can't be used to redirect off-site.
+func (a *app) doModerate(w http.ResponseWriter, r *http.Request) {
+	if a.authn == nil {
+		http.NotFound(w, r)
+		return
+	}
+	_ = r.ParseForm()
+	id, _ := strconv.ParseInt(r.FormValue("id"), 10, 64)
+	ctx := r.Context()
+	switch r.FormValue("action") {
+	case "hide":
+		admin, _, _ := a.acct(&beach.Ctx{W: w, R: r})
+		_ = a.store.hide(ctx, id, admin)
+	case "restore":
+		_ = a.store.restore(ctx, id)
+	case "purge":
+		_ = a.store.purge(ctx, id)
+	}
+	back := r.FormValue("back")
+	if !strings.HasPrefix(back, "/admin") {
+		back = "/admin/review"
+	}
+	http.Redirect(w, r, back, http.StatusSeeOther)
+}
+
+// postsBack is the browser's round-trip path: moderating a row 303s back to
+// the same filtered view.
+func postsBack(author, ip string) string {
+	q := url.Values{}
+	if author != "" {
+		q.Set("author", author)
+	}
+	if ip != "" {
+		q.Set("ip", ip)
+	}
+	if len(q) == 0 {
+		return "/admin/posts"
+	}
+	return "/admin/posts?" + q.Encode()
+}
+
+// snippetCap keeps the browser's content column scannable.
+const snippetCap = 90
+
+// snippet flattens a post's sanitized HTML to plain text for a table cell:
+// stripPolicy (text.go) drops the tags, unescape undoes its entity escaping
+// (templ re-escapes on render), and the cap truncates.
+func snippet(bodyHTML string) string {
+	plain := html.UnescapeString(strings.Join(strings.Fields(stripPolicy.Sanitize(bodyHTML)), " "))
+	r := []rune(plain)
+	if len(r) > snippetCap {
+		return string(r[:snippetCap]) + "…"
+	}
+	return plain
+}
+
+// authorLabel names a row's author; open-mode and seed posts have none.
+func authorLabel(author string) string {
+	if author == "" {
+		return "anon"
+	}
+	return author
+}
+
+// metaLine is the capture-time request context as one terse line:
+// ip · country · city · ua, absent parts skipped.
+func metaLine(m Meta) string {
+	var parts []string
+	for _, s := range []string{m.IP, m.Country, m.City, m.UA} {
+		if s != "" {
+			parts = append(parts, s)
+		}
+	}
+	if len(parts) == 0 {
+		return "—"
+	}
+	return strings.Join(parts, " · ")
+}
+
+// geoLabel is country · city, whichever the capture had.
+func geoLabel(m Meta) string {
+	switch {
+	case m.Country != "" && m.City != "":
+		return m.Country + " · " + m.City
+	case m.Country != "":
+		return m.Country
+	default:
+		return m.City
+	}
+}
+
+// fmtScore prints a reputation number plainly — these pages are the one place
+// the numbers appear at all.
+func fmtScore(s float64) string {
+	return strconv.FormatFloat(s, 'f', -1, 64)
+}
diff --git a/examples/hush/adminviews.templ b/examples/hush/adminviews.templ
new file mode 100644
index 0000000..10a2aa5
--- /dev/null
+++ b/examples/hush/adminviews.templ
@@ -0,0 +1,256 @@
+// hush's admin views — the pages with eyes. Same stark black/white shell as
+// the wall, but nothing is withheld here: scores, tiers, chains, counts, IPs,
+// geo, and user agents all print. Handlers live in admin.go; everything is
+// behind app.Can("admin").
+package main
+
+import "strconv"
+
+// adminPage is the admin shell: the hush header, the section nav, and a wide
+// column — dense tables don't fit the member pages' 720px.
+templ adminPage(title string, section string) {
+	@shell("hush — " + title) {
+		<div class="hush-adm">
+			<header class="hush-head">
+				<h1 class="hush-title"><a class="hush-home" href="/">hush</a></h1>
+				<p class="hush-sub">{ title }</p>
+			</header>
+			@adminNav(section)
+			{ children... }
+		</div>
+	}
+}
+
+// adminNav links the suite together; the page you're on goes inert.
+templ adminNav(section string) {
+	<nav class="hush-adm-nav">
+		@adminNavLink("hub", "/admin", section)
+		@adminNavLink("review", "/admin/review", section)
+		@adminNavLink("posts", "/admin/posts", section)
+		@adminNavLink("members", "/admin/members", section)
+		@adminNavLink("queue", "/admin/queue", section)
+	</nav>
+}
+
+templ adminNavLink(name string, href string, current string) {
+	if name == current {
+		<span class="hush-adm-here">{ name }</span>
+	} else {
+		<a class="hush-link" href={ href }>{ name }</a>
+	}
+}
+
+// adminHubPage is /admin: the four numbers, each a way into the section that
+// explains it.
+templ adminHubPage(st adminStats) {
+	@adminPage("admin", "hub") {
+		<div class="hush-adm-stats">
+			@hubStat(st.Pending, "pending applications", "/admin/queue")
+			@hubStat(st.Flagged, "flagged or hidden", "/admin/review")
+			@hubStat(st.Posts, "posts", "/admin/posts")
+			@hubStat(st.Members, "members", "/admin/members")
+		</div>
+	}
+}
+
+// hubStat is one number on the hub, linking into its section.
+templ hubStat(n int, label string, href string) {
+	<a class="hush-stat hush-adm-stat" href={ href }>
+		<span class="hush-stat-n">{ strconv.Itoa(n) }</span>
+		{ label }
+	</a>
+}
+
+// adminReviewPage is the moderation queue: every hidden or flagged post in
+// full — the admin judges the actual content, not a snippet — with the
+// capture meta, who flagged, and the two rulings.
+templ adminReviewPage(posts []Post, flaggers map[int64][]flagRow) {
+	@adminPage("review", "review") {
+		if len(posts) == 0 {
+			<p class="hush-sub hush-adm-empty">nothing to review.</p>
+		}
+		for _, p := range posts {
+			@reviewCard(p, flaggers[p.ID])
+		}
+	}
+}
+
+// reviewCard is one post under review, rendered whole.
+templ reviewCard(p Post, flags []flagRow) {
+	{{ id := strconv.FormatInt(p.ID, 10) }}
+	<div class="hush-revcard">
+		<div class="hush-adm-line">
+			<span>{ "#" + id }</span>
+			if p.Hidden {
+				<span class="hush-adm-badge">hidden</span>
+			}
+			<span class="hush-adm-dim">{ authorLabel(p.Author) }</span>
+			<span class="hush-adm-dim">{ p.CreatedAt.Format("Jan 2 2006 · 15:04") }</span>
+		</div>
+		@cardMedia(p)
+		<div class="hush-adm-meta">{ metaLine(p.Meta) }</div>
+		<div class="hush-adm-flags">
+			<span>{ strconv.Itoa(p.FlagCount) + " flags" }</span>
+			for _, f := range flags {
+				<span class="hush-adm-dim">{ f.Flagger + " (t" + strconv.Itoa(f.Tier) + ")" }</span>
+			}
+		</div>
+		<div class="hush-adm-actions">
+			@moderateForm(id, "restore", "/admin/review")
+			@moderateForm(id, "purge", "/admin/review")
+		</div>
+	</div>
+}
+
+// moderateForm posts one ruling — hide, restore, or purge — for a post and
+// 303s back to where the form lives. purge is forever; there is no undo and
+// the button doesn't pretend otherwise.
+templ moderateForm(id string, action string, back string) {
+	<form method="post" action="/admin/moderate">
+		<input type="hidden" name="id" value={ id }/>
+		<input type="hidden" name="action" value={ action }/>
+		<input type="hidden" name="back" value={ back }/>
+		<button class="hush-post hush-post--mini" type="submit">{ action }</button>
+	</form>
+}
+
+// adminPostsPage is the everything browser: every post, hidden included,
+// newest-first, every column the wall conceals — with exact-match author/ip
+// filters that survive the moderation round-trip (back carries them).
+templ adminPostsPage(posts []Post, votes map[int64]voteCount, author string, ip string) {
+	{{ back := postsBack(author, ip) }}
+	@adminPage("posts", "posts") {
+		<form method="get" action="/admin/posts" class="hush-adm-filter">
+			<input class="hush-input hush-adm-in" type="text" name="author" placeholder="author" value={ author }/>
+			<input class="hush-input hush-adm-in" type="text" name="ip" placeholder="ip" value={ ip }/>
+			<button class="hush-post hush-post--mini" type="submit">filter</button>
+			if author != "" || ip != "" {
+				<a class="hush-link" href="/admin/posts">clear</a>
+			}
+		</form>
+		if len(posts) == 0 {
+			<p class="hush-sub hush-adm-empty">no posts match.</p>
+		} else {
+			<table class="hush-adm-table">
+				<thead>
+					<tr>
+						<th>id</th>
+						<th>kind</th>
+						<th>content</th>
+						<th>author</th>
+						<th>ip</th>
+						<th>geo</th>
+						<th>ua</th>
+						<th>likes</th>
+						<th>dislikes</th>
+						<th>flags</th>
+						<th></th>
+						<th></th>
+					</tr>
+				</thead>
+				<tbody>
+					for _, p := range posts {
+						@postRow(p, votes[p.ID], back)
+					}
+				</tbody>
+			</table>
+		}
+	}
+}
+
+// postRow is one line of the browser: the full ledger for one post. Hidden
+// posts lose their permalink (it 404s off the wall), so only visible ids link.
+templ postRow(p Post, v voteCount, back string) {
+	{{ id := strconv.FormatInt(p.ID, 10) }}
+	<tr>
+		<td>
+			if p.Hidden {
+				{ "#" + id }
+			} else {
+				<a class="hush-link" href={ postHref(p.ID) }>{ "#" + id }</a>
+			}
+		</td>
+		<td>{ p.Kind }</td>
+		<td class="hush-adm-content">
+			if p.Kind == "image" {
+				<img class="hush-adm-thumb" src={ p.ImageURL } alt="" loading="lazy"/>
+			} else {
+				{ snippet(p.BodyHTML) }
+			}
+		</td>
+		<td>{ authorLabel(p.Author) }</td>
+		<td class="hush-adm-dim">{ p.Meta.IP }</td>
+		<td class="hush-adm-dim">{ geoLabel(p.Meta) }</td>
+		<td class="hush-adm-ua" title={ p.Meta.UA }>{ p.Meta.UA }</td>
+		<td>{ strconv.Itoa(v.Up) }</td>
+		<td>{ strconv.Itoa(v.Down) }</td>
+		<td>{ strconv.Itoa(p.FlagCount) }</td>
+		<td>
+			if p.Hidden {
+				<span class="hush-adm-badge">hidden</span>
+			}
+		</td>
+		<td>
+			<div class="hush-adm-actions">
+				if p.Hidden {
+					@moderateForm(id, "restore", back)
+				} else {
+					@moderateForm(id, "hide", back)
+				}
+				@moderateForm(id, "purge", back)
+			</div>
+		</td>
+	</tr>
+}
+
+// adminMembersPage is the member ledger: every account, its roles, the real
+// numbers (score · tier · chain), post count, email (hush_member_emails often
+// has no row — that's the dash), invites minted/used, and last-seen IP.
+templ adminMembersPage(members []memberRow) {
+	@adminPage("members", "members") {
+		if len(members) == 0 {
+			<p class="hush-sub hush-adm-empty">no members yet.</p>
+		} else {
+			<table class="hush-adm-table">
+				<thead>
+					<tr>
+						<th>handle</th>
+						<th>roles</th>
+						<th>score</th>
+						<th>tier</th>
+						<th>chain</th>
+						<th>posts</th>
+						<th>email</th>
+						<th>invites</th>
+						<th>last ip</th>
+					</tr>
+				</thead>
+				<tbody>
+					for _, m := range members {
+						<tr>
+							<td>{ m.Handle }</td>
+							<td class="hush-adm-dim">{ m.Roles }</td>
+							<td>{ fmtScore(m.Score) }</td>
+							<td>{ "t" + strconv.Itoa(m.Tier) }</td>
+							<td>{ fmtScore(m.Chain) }</td>
+							<td>{ strconv.Itoa(m.Posts) }</td>
+							<td>
+								if m.Email == "" {
+									<span class="hush-adm-dim">—</span>
+								} else if m.Verified {
+									{ m.Email }
+									<span class="hush-adm-badge">verified</span>
+								} else {
+									{ m.Email }
+									<span class="hush-adm-dim">unverified</span>
+								}
+							</td>
+							<td>{ strconv.Itoa(m.Minted) + " minted · " + strconv.Itoa(m.Used) + " used" }</td>
+							<td class="hush-adm-dim">{ m.LastIP }</td>
+						</tr>
+					}
+				</tbody>
+			</table>
+		}
+	}
+}
diff --git a/examples/hush/adminviews_templ.go b/examples/hush/adminviews_templ.go
