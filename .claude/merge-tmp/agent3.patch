+++ b/examples/hush/analyticsviews.templ
@@ -0,0 +1,104 @@
+// The admin analytics views: the dashboard page of deferred widgets, and the
+// two table fragments. Charts ride the framework's chart styling (app.css is
+// linked by the shell, and the dash-widget card is the chart-core contract);
+// only the tables are hush.css. Like every admin surface, this page may show
+// everything the wall hides — handles, IPs, counts.
+package main
+
+import (
+	"strconv"
+
+	"github.com/ThirdCoastInteractive/the-beach/ui"
+)
+
+// analyticsView is the dashboard: a grid of deferred chart and table widgets.
+// Each placeholder reserves its height and @gets its fragment on intersection
+// (the pantry pattern) — the ClickHouse aggregates never block first paint.
+templ analyticsView(handle string, admin bool, tier int) {
+	@shell("hush — analytics") {
+		@accountStrip(handle, admin, tier)
+		<div class="hush-top hush-anl">
+			<header class="hush-head">
+				<h1 class="hush-title">hush</h1>
+				<p class="hush-sub">analytics — admin eyes only.</p>
+			</header>
+			@backToWall()
+			<div class="hush-anl-grid">
+				@anlCard("events — 14 days", "anl-events", "/admin/analytics/events", "260px")
+				@anlCard("posts per day — 14 days", "anl-posts", "/admin/analytics/posts", "320px")
+				@anlCard("votes per day — 14 days", "anl-votes", "/admin/analytics/votes", "320px")
+				@anlCard("top countries — 30 days", "anl-countries", "/admin/analytics/countries", "260px")
+				@anlCard("top ips — 30 days", "anl-ips", "/admin/analytics/ips", "420px")
+				@anlCard("recent events — last 100", "anl-recent", "/admin/analytics/recent", "420px")
+			</div>
+		</div>
+	}
+}
+
+// anlCard is one widget card. The dash-widget classes are the chart-core
+// contract (framework-styled); the body reserves its height inline so the
+// deferred fragment patches in with zero layout shift.
+templ anlCard(title, id, src, height string) {
+	<article class="dash-widget">
+		<header class="dash-widget-header">
+			<h2 class="dash-widget-title">{ title }</h2>
+		</header>
+		<div class="dash-widget-body" style={ "height:" + height }>
+			@ui.Defer(ui.DeferProps{ID: id, Get: src, Height: "100%"})
+		</div>
+	</article>
+}
+
+// ipsTable ranks source IPs by event count — dense and monochrome, built to
+// be read down the left column into a blocklist.
+templ ipsTable(rows []labelCount) {
+	<div id="anl-ips" class="hush-anl-scroll">
+		<table class="hush-anl-table">
+			<thead>
+				<tr><th>ip</th><th class="hush-anl-num">events</th></tr>
+			</thead>
+			<tbody>
+				for _, r := range rows {
+					<tr>
+						<td>{ r.L }</td>
+						<td class="hush-anl-num">{ strconv.FormatUint(r.N, 10) }</td>
+					</tr>
+				}
+				if len(rows) == 0 {
+					<tr><td colspan="2" class="hush-anl-empty">nothing yet.</td></tr>
+				}
+			</tbody>
+		</table>
+	</div>
+}
+
+// recentTable is the raw event tail, newest first.
+templ recentTable(rows []recentEvent) {
+	<div id="anl-recent" class="hush-anl-scroll">
+		<table class="hush-anl-table">
+			<thead>
+				<tr><th>ts</th><th>kind</th><th>handle</th><th class="hush-anl-num">post</th><th>ip</th><th>country</th><th>path</th></tr>
+			</thead>
+			<tbody>
+				for _, r := range rows {
+					<tr>
+						<td>{ r.TS.Format("Jan 2 15:04:05") }</td>
+						<td>{ r.Kind }</td>
+						<td>{ r.Handle }</td>
+						<td class="hush-anl-num">
+							if r.PostID != 0 {
+								{ strconv.FormatInt(r.PostID, 10) }
+							}
+						</td>
+						<td>{ r.IP }</td>
+						<td>{ r.Country }</td>
+						<td>{ r.Path }</td>
+					</tr>
+				}
+				if len(rows) == 0 {
+					<tr><td colspan="7" class="hush-anl-empty">nothing yet.</td></tr>
+				}
+			</tbody>
+		</table>
+	</div>
+}
