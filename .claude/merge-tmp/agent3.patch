+    ts      DateTime,
+    kind    LowCardinality(String),
+    handle  String,
+    post_id Int64,
+    ip      String,
+    country LowCardinality(String),
+    city    String,
+    ua      String,
+    path    String
+) ENGINE = MergeTree
+ORDER BY (kind, ts);
+
+-- +goose Down
+DROP TABLE hush_events;
