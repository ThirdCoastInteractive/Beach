# pantry — copy to .env for local runs (`go run ./examples/pantry`).
#
# docker compose sets its own service-name values; these point at a LOCAL
# Postgres/ClickHouse (e.g. one you ran with published ports). Unset DATABASE_URL
# entirely to run database-less (in-memory store, no auth).
PORT=8080
DATABASE_URL=postgres://beach:beach@localhost:5432/pantry?sslmode=disable
CLICKHOUSE_DSN=clickhouse://beach:beach@localhost:9000/beach
