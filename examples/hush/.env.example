# hush — copy to .env for local runs (`go run ./examples/hush`).
#
# docker compose sets its own service-name value; this points at a LOCAL Postgres
# (e.g. one you ran with a published port). Unset DATABASE_URL entirely to run
# open/database-less (no gate — anyone can post).
PORT=8080
DATABASE_URL=postgres://beach:beach@localhost:5432/hush?sslmode=disable

# Open the first N registrations with no review (the switch-on-later mode);
# once spent, the application queue resumes. Unset/0 = queue + invites only.
#HUSH_OPEN_SLOTS=50
