# hush config for `go run ./examples/hush` — copy to .env (gitignored).
# Running the containerized stack instead? Use .env.docker.example.
#
# The database lives wherever DATABASE_URL points (a local Postgres you started
# yourself); unset it to run open and in-memory, no gate. That one line is the
# whole database story here — there is no separate credentials block, because
# go run doesn't create the database, it just connects to one.

PORT=8080
DATABASE_URL=postgres://beach:beach@localhost:5432/hush?sslmode=disable

# ClickHouse, the observation store behind /admin/analytics. Unset = analytics
# off (the wall runs identically). Set-but-unreachable panics at boot.
#CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/hush

# Absolute origin for the links inside outgoing email (verification, invites).
#HUSH_BASE_URL=http://localhost:8080

# The points a verified email is worth on the author track. Baked into the
# reputation engine at boot, so it stays env (unlike the policy seeds below).
#HUSH_EMAIL_POINTS=2

# ── First-boot policy seeds ────────────────────────────────────────────────
# The gate-and-moderation policy lives in the DATABASE and is edited live at
# /admin/settings — no restart. These vars only SEED an empty hush_settings
# table on first boot; once seeded the database is authoritative and changing
# them here does nothing. (Database-less mode has no settings table, so these
# are the live values there.)
#HUSH_TIER1=3            # author score that unlocks tier 1 (the profile + invites)
#HUSH_TIER2=8            # author score that unlocks tier 2 (DMs)
#HUSH_FLAG_TIER=1        # a flag from this tier or above insta-hides a post
#HUSH_FLAG_QUORUM=3      # this many tier-0 flags hide a post by agreement
#HUSH_INVITE_BASE=3      # a tier-1 member's starting invite allowance
#HUSH_INVITE_MAX=6       # invite hard cap, however high the chain climbs
#HUSH_OPEN_SLOTS=0       # first-come registrations with no review; 0 = queue only
#HUSH_ADMIN_EMAIL=       # where new-application notices go; blank = none
# ───────────────────────────────────────────────────────────────────────────

# Transactional email transport — with all of this unset, the log mailer runs
# and "sent" mail prints to the app log (the dev default; the flows still
# work). Set Mailgun, or SMTP, for real delivery — see mailer/mailer.go.
#MAIL_FROM_NAME=hush
#MAIL_FROM_ADDR=hush@example.com
#MAILGUN_KEY=
#MAILGUN_DOMAIN=
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=

# Local file store root when R2 is not configured. Unset = an ephemeral
# directory under the OS temp dir.
#HUSH_FILES_DIR=

# Cloudflare R2 file store — set all four and files (application photos,
# non-Cloudflare-Images post images) live in the bucket instead of a local
# temp dir. Leave unset for local dev.
#R2_ENDPOINT=accountid.r2.cloudflarestorage.com   # the bucket's S3 API host (no scheme)
#R2_BUCKET=hush                                   # bucket name; one store per bucket
#R2_ACCESS_KEY_ID=                                # R2 API token key pair (dashboard -> R2 -> API tokens)
#R2_SECRET_ACCESS_KEY=
#R2_PUBLIC_URL=https://files.example.com          # public/custom-domain base for stable URLs; unset = presigned 1h links

# Cloudflare Images — set all three and image posts upload there instead of
# the file store, served resized from imagedelivery.net. The variants are
# created in the CF dashboard: "public" full-size, "thumb" a square crop
# (~600px, fit: cover) for the grid tiles.
#CF_IMAGES_ACCOUNT_ID=                            # account id (dashboard -> images -> overview)
#CF_IMAGES_TOKEN=                                 # api token with Cloudflare Images edit permission
#CF_IMAGES_HASH=                                  # delivery hash, the first path segment of imagedelivery.net urls
#CF_IMAGES_VARIANT=public                         # full-size variant feed cards render (default "public")
#CF_IMAGES_THUMB=thumb                            # square-crop variant grid tiles render (default "thumb")
