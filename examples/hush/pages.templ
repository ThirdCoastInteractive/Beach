// hush's views, as templ components. The handlers (main.go, apply.go, auth.go)
// stay plain Go and call these with data; everything that emits markup lives
// here.
package main

import (
	"strconv"

	"github.com/ThirdCoastInteractive/the-beach/ui"
)

// The style helpers below are the only inline styles in hush, and all of them
// are safe to exempt from templ's CSS property sanitizer (which predates
// oklch()): colorFor's output is a fixed-format oklch() string derived from a
// content hash, and the view-transition-name is "hush-post-" plus a decimal
// id — no user input reaches either.

// tileBG paints a text post's computed color (the card hero in the feed).
func tileBG(p Post) templ.SafeCSS {
	return templ.SafeCSS("background: " + colorFor(p))
}

// postStyle is a tile's inline style: its computed color plus the post
// transition class. The name itself arrives only on focus (the :focus rule in
// hush.css), so leaving the wall morphs one hero square — not seventeen.
func postStyle(p Post) templ.SafeCSS {
	return templ.SafeCSS("background: " + colorFor(p) + "; view-transition-class: hush-post")
}

// vtName is a post's view-transition-name.
func vtName(p Post) string {
	return "hush-post-" + strconv.FormatInt(p.ID, 10)
}

// vtStyle names a feed card for the morph, unconditionally — consecutive
// posts share most of their neighbors, so a feed→feed navigation pairs the
// overlap and the column slides. side ("hush-above"/"hush-below"/"" for the
// focused card) classes the card by its end of the feed, so a card with no
// pair on the other page enters or exits along its own side instead of
// popping or fading.
func vtStyle(p Post, side string) templ.SafeCSS {
	s := "view-transition-name: " + vtName(p) + "; view-transition-class: hush-post"
	if side != "" {
		s += " " + side
	}
	return templ.SafeCSS(s)
}

// postHref is the real link to a post's feed page. The fragment lands the
// browser on the focused card even when newer neighbors render above it —
// native scroll-to-fragment, no script.
func postHref(id int64) string {
	s := strconv.FormatInt(id, 10)
	return "/p/" + s + "#p" + s
}

// moreGet is a sentinel's intersect expression: fetch the next batch of feed
// neighbors past cursor in the given direction.
func moreGet(dir string, cursor int64) string {
	return "@get('/feed/" + dir + "?cursor=" + strconv.FormatInt(cursor, 10) + "')"
}

// shell is the full hush document. hush is the custom-layout example, so it
// ships its own page shell rather than the driftwood one: it links the
// framework stylesheet (so dw-* surfaces still resolve) AND its own hush.css,
// keeps the theme class on <html> for no pop-in, and defers Datastar per the
// no-blocking law. No inline script — the strict CSP forbids it.
templ shell(title string) {
	<!DOCTYPE html>
	<html lang="en" class="dw-root">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<link rel="stylesheet" href="/static/css/hush.css"/>
			<script type="module" src="/static/js/datastar.js" defer></script>
		</head>
		<body class="dw-body hush-body">
			{ children... }
		</body>
	</html>
}

// backToWall is the "← back to the wall" escape hatch every secondary page ends with.
templ backToWall() {
	<p class="hush-back"><a class="hush-link" href="/">← back to the wall</a></p>
}

// homePage is the wall: the centered header + composer, then the full-bleed
// gapless grid. Tiles are real links — opening a post is a navigation (the
// browser owns push/pop state), and the cross-document View Transition morphs
// the clicked square into its feed card.
templ homePage(posts []Post, handle string, canPost bool, admin bool, tier int, openLeft int) {
	@shell("hush") {
		@accountStrip(handle, admin, tier)
		<div class="hush-top">
			<header class="hush-head">
				<h1 class="hush-title"><a class="hush-home" href="/">hush</a></h1>
				<p class="hush-sub">a quiet wall — post into it.</p>
			</header>
			if canPost {
				@composer()
			} else if openLeft > 0 {
				<p class="hush-sub hush-gateline">{ strconv.Itoa(openLeft) + " seats open — " }<a class="hush-link" href="/apply">claim one</a> or <a class="hush-link" href="/login">sign in</a>.</p>
			} else {
				<p class="hush-sub hush-gateline">posting is invite-only — <a class="hush-link" href="/apply">apply</a> or <a class="hush-link" href="/login">sign in</a>.</p>
			}
		</div>
		@grid(posts)
	}
}

// accountStrip is the top-right account line: who you are, the admin queue
// link, and log out. No score, no tier — standing is never printed; the
// profile link simply appearing IS how you learn you've reached tier 1.
// Empty when signed out (the gate line carries the call to action) or in
// database-less open mode.
templ accountStrip(handle string, admin bool, tier int) {
	if handle != "" {
		<div class="hush-acct">
			you are <strong>{ handle }</strong>
			if tier >= 1 {
				{ " · " }
				<a class="hush-link" href={ "/u/" + handle }>profile</a>
			}
			if admin {
				{ " · " }
				<a class="hush-link" href="/admin/queue">queue</a>
			}
			{ " · " }
			<a class="hush-link" href="/logout">log out</a>
		</div>
	}
}

// composer is the post box: a textarea bound to the `body` signal and a post
// button that fires @post('/posts'). No <form> — a bare button avoids needing
// a submit-prevent modifier, and Datastar carries the signal as JSON. The
// image upload below it IS a plain multipart form (303 back to the wall) — no
// Datastar, no inline script, CSP-clean; the camera island adds the
// fetch-based prepend path.
templ composer() {
	<div class="hush-compose">
		<textarea id="hush-body" name="body" class="hush-input" data-bind:body aria-label="compose a post" placeholder="say something — **bold**, *italics*, - lists"></textarea>
		<div class="hush-compose-row">
			<span class="hush-hint">bold · italics · lists · 512 characters</span>
			<button class="hush-post" data-on:click="@post('/posts')">post</button>
		</div>
		<div id="hush-note" class="hush-note" aria-live="polite"></div>
		<form class="hush-upload" method="post" action="/upload" enctype="multipart/form-data">
			<input type="file" id="hush-image" name="image" accept="image/*" class="hush-file"/>
			<button class="hush-post hush-post--ghost" type="submit">upload image</button>
			<a class="hush-link hush-cam-link" href="/compose">or open the camera →</a>
		</form>
	</div>
}

// grid is the full #hush-grid wall. It doubles as the fragment the home
// handler patches on a Datastar request.
templ grid(posts []Post) {
	<div id="hush-grid" class="hush-grid">
		for _, p := range posts {
			@tile(p)
		}
	</div>
}

// tile is one square — a real link to the post's feed page. Its data-vt only
// becomes a live view-transition-name while the tile holds focus (i.e. it was
// just clicked), so navigating morphs exactly this square into the focused
// card. A text tile's BodyHTML is already sanitized by renderPost; an image
// tile renders the stored object's URL.
templ tile(p Post) {
	if p.Kind == "image" {
		<a class="hush-tile hush-tile--image" style={ postStyle(p) } data-vt={ vtName(p) } href={ postHref(p.ID) }>
			<img src={ p.ImageURL } alt="" loading="lazy"/>
		</a>
	} else {
		<a class="hush-tile hush-tile--text" style={ postStyle(p) } data-vt={ vtName(p) } href={ postHref(p.ID) }>
			<div class="hush-tile-body">
				@templ.Raw(p.BodyHTML)
			</div>
		</a>
	}
}

// reactions is the thumbs control in a focused card. No counts, no ratio —
// scores are hidden everywhere; the only readable state is your own mark
// (your thumb inverts once you've reacted, and the pair goes quiet). The
// fragment IS #vote-<id>, so the vote handler morphs it by id (PatchOuter —
// inner mode would nest #vote-<id> inside itself).
templ reactions(p Post, canPost bool, myVote int8) {
	{{ idStr := strconv.FormatInt(p.ID, 10) }}
	<div id={ "vote-" + idStr } class="hush-react">
		if myVote > 0 {
			<span class="hush-react-btn hush-react-btn--mine">
				@ui.Icon("thumb-up", ui.IconLabel("you liked this"))
			</span>
			<span class="hush-react-btn hush-react-btn--off">
				@ui.Icon("thumb-down")
			</span>
		} else if myVote < 0 {
			<span class="hush-react-btn hush-react-btn--off">
				@ui.Icon("thumb-up")
			</span>
			<span class="hush-react-btn hush-react-btn--mine">
				@ui.Icon("thumb-down", ui.IconLabel("you disliked this"))
			</span>
		} else if canPost {
			<button class="hush-react-btn" data-on:click={ "@post('/p/" + idStr + "/vote?dir=up')" } aria-label="like">
				@ui.Icon("thumb-up")
			</button>
			<button class="hush-react-btn" data-on:click={ "@post('/p/" + idStr + "/vote?dir=down')" } aria-label="dislike">
				@ui.Icon("thumb-down")
			</button>
		} else {
			<span class="hush-react-btn hush-react-btn--off">
				@ui.Icon("thumb-up")
			</span>
			<span class="hush-react-btn hush-react-btn--off">
				@ui.Icon("thumb-down")
			</span>
		}
	</div>
}

// feedPage is a post's page: the focused post expanded (just its media, meta,
// and the thumbs — there are no replies; a post stands alone) with its
// time-ordered neighbors around it — newer above, older below, newest-first
// all the way down. Up to feedSpan neighbors render each way; an intersect
// sentinel past each end pulls the next batch as you scroll, so the whole
// timeline is reachable from any post without a single control. The only
// other affordance is the title, which is the way back to the wall — that and
// the browser's own back button.
templ feedPage(newer []Post, focused Post, older []Post, moreNewer bool, moreOlder bool, canPost bool, myVote int8, handle string, admin bool, tier int) {
	@shell("hush — post #" + strconv.FormatInt(focused.ID, 10)) {
		@accountStrip(handle, admin, tier)
		<header class="hush-head hush-head--feed">
			<h1 class="hush-title"><a class="hush-home" href="/">hush</a></h1>
		</header>
		<div class="hush-feed">
			if moreNewer {
				@moreSentinel("newer", newer[0].ID)
			}
			for _, p := range newer {
				@feedCard(p, "hush-above")
			}
			@focusedCard(focused, canPost, myVote)
			for _, p := range older {
				@feedCard(p, "hush-below")
			}
			if moreOlder {
				@moreSentinel("older", older[len(older)-1].ID)
			}
		</div>
	}
}

// focusedCard is the expanded post at the center of its feed page: media,
// meta, the thumbs. Nothing else — no thread, no reply box; the wall doesn't
// talk back. Its id is the link fragment that lands the browser here.
templ focusedCard(p Post, canPost bool, myVote int8) {
	{{ id := strconv.FormatInt(p.ID, 10) }}
	<article id={ "p" + id } class="hush-fcard hush-fcard--focused" style={ vtStyle(p, "") }>
		@cardMedia(p)
		<div class="hush-card-meta">
			{ "#" + id + " · " + p.CreatedAt.Format("Jan 2 · 15:04") }
		</div>
		@reactions(p, canPost, myVote)
	</article>
}

// feedCard is a neighbor in the feed — the post's media and meta, and one rail
// out: the whole card is a link to its own page, where it renders focused.
// Unlike grid tiles, feed cards are named unconditionally: most of them exist
// on the next post's page too, so a feed→feed navigation morphs them to their
// new positions — the feed reads as sliding, not reloading.
templ feedCard(p Post, side string) {
	{{ id := strconv.FormatInt(p.ID, 10) }}
	<a id={ "p" + id } class="hush-fcard" style={ vtStyle(p, side) } href={ postHref(p.ID) }>
		@cardMedia(p)
		<div class="hush-card-meta">
			{ "#" + id + " · " + p.CreatedAt.Format("Jan 2 · 15:04") }
		</div>
	</a>
}

// moreSentinel is an invisible strip past the feed's last rendered card in
// each direction. When it scrolls into view it fetches the next batch once;
// the batch fragment replaces it (cards plus a fresh sentinel while more
// remain), so the feed extends itself as long as there is timeline left.
templ moreSentinel(dir string, cursor int64) {
	<div id={ "feed-" + dir } class="hush-more" data-on-intersect__once={ moreGet(dir, cursor) }></div>
}

// feedBatch is what a sentinel becomes: the next cards in display order with
// the follow-up sentinel on the outward side, under a display:contents wrapper
// (the patch needs one root; layout never sees it).
templ feedBatch(dir string, posts []Post, more bool) {
	<div class="hush-batch">
		if dir == "newer" {
			if more {
				@moreSentinel("newer", posts[0].ID)
			}
			for _, p := range posts {
				@feedCard(p, "hush-above")
			}
		} else {
			for _, p := range posts {
				@feedCard(p, "hush-below")
			}
			if more {
				@moreSentinel("older", posts[len(posts)-1].ID)
			}
		}
	</div>
}

// cardMedia is a post's hero in the feed: the image, or the text on the
// post's own computed color.
templ cardMedia(p Post) {
	if p.Kind == "image" {
		<div class="hush-card-media hush-card-media--image">
			<img src={ p.ImageURL } alt=""/>
		</div>
	} else {
		<div class="hush-card-media hush-card-media--text" style={ tileBG(p) }>
			<div class="hush-card-text">
				@templ.Raw(p.BodyHTML)
			</div>
		</div>
	}
}

// notFoundPage is shown when a permalink points at a post that doesn't exist.
templ notFoundPage() {
	@shell("hush — not found") {
		<div class="hush-top">
			<header class="hush-head">
				<h1 class="hush-title">hush</h1>
				<p class="hush-sub">that post is gone.</p>
			</header>
			@backToWall()
		</div>
	}
}

// profilePage is the tier-1 reward: having one at all. Scores are hidden —
// no number anywhere ever says how you're doing; what you see is what has
// unlocked (the page itself, the DM line, the invite allowance). The wall
// stays anonymous, so this is the one place a handle is shown with anything.
templ profilePage(handle string, tier int, posts int, panel invitePanel) {
	@shell("hush — " + handle) {
		<div class="hush-top">
			<header class="hush-head">
				<h1 class="hush-title">{ handle }</h1>
			</header>
			<div class="hush-profile">
				<div class="hush-stat"><span class="hush-stat-n">{ strconv.Itoa(posts) }</span> posts</div>
			</div>
			if tier < 2 {
				<p class="hush-sub">DMs unlock as your standing rises.</p>
			} else {
				<p class="hush-sub">DMs unlocked.</p>
			}
			if panel.Show {
				@invitesSection(panel)
			}
			@backToWall()
		</div>
	}
}

// invitesSection is the invite panel on your own profile: the throttle math
// (chain standing sets the allowance), every minted code as a shareable link,
// and the mint button while the allowance has room.
templ invitesSection(panel invitePanel) {
	<section class="hush-invites">
		<h2 class="hush-invites-title">invites</h2>
		<p class="hush-sub">{ strconv.Itoa(len(panel.Invites)) + " of " + strconv.Itoa(panel.Allowance) + " minted — your chain's standing sets the allowance." }</p>
		for _, inv := range panel.Invites {
			<div class="hush-invite-row">
				<span class="hush-invite-code">{ "/invite/" + inv.Code }</span>
				if inv.UsedBy != "" {
					<span class="hush-invite-used">{ "→ " + inv.UsedBy }</span>
				} else {
					<span class="hush-invite-open">unclaimed</span>
				}
			</div>
		}
		if panel.Remaining > 0 {
			<form method="post" action="/invites" class="hush-invite-mint">
				<button class="hush-post hush-post--ghost" type="submit">mint an invite</button>
			</form>
		} else {
			<p class="hush-hint">no invites available — your chain has to earn them.</p>
		}
	</section>
}

// registerFormPage is the open-seats door: while HUSH_OPEN_SLOTS has seats
// left, signing up is a handle and a password — no pitch, no queue.
templ registerFormPage(left int, errMsg string) {
	@formPage("claim a seat") {
		<p class="hush-sub">{ "first-come registration is open — " + strconv.Itoa(left) + " seats left." }</p>
		if errMsg != "" {
			<p class="hush-note">{ errMsg }</p>
		}
		<form method="post" action="/register" class="hush-form">
			<input class="hush-input" type="text" name="handle" placeholder="handle" autocomplete="username" required/>
			<input class="hush-input" type="password" name="password" placeholder="password" autocomplete="new-password" required/>
			<div class="hush-form-row">
				<a class="hush-link" href="/login">already in? sign in →</a>
				<button class="hush-post" type="submit">claim</button>
			</div>
		</form>
	}
}

// inviteFormPage redeems a live invite code: a handle and a password, and the
// account exists — the inviter's chain answers for you from here on.
templ inviteFormPage(code string, errMsg string) {
	@formPage("you're invited") {
		if errMsg != "" {
			<p class="hush-note">{ errMsg }</p>
		}
		<form method="post" action={ "/invite/" + code } class="hush-form">
			<input class="hush-input" type="text" name="handle" placeholder="handle" autocomplete="username" required/>
			<input class="hush-input" type="password" name="password" placeholder="password" autocomplete="new-password" required/>
			<div class="hush-form-row">
				<a class="hush-link" href="/login">already in? sign in →</a>
				<button class="hush-post" type="submit">join</button>
			</div>
		</form>
	}
}

// noticePage is a centered one-line message page (e.g. "application submitted").
templ noticePage(title string, sub string) {
	@shell("hush") {
		<div class="hush-top">
			<header class="hush-head">
				<h1 class="hush-title">hush</h1>
				<p class="hush-sub">{ title }</p>
				if sub != "" {
					<p class="hush-sub">{ sub }</p>
				}
			</header>
			@backToWall()
		</div>
	}
}

// formPage centers a form (login, apply) under the hush header.
templ formPage(title string) {
	@shell("hush — " + title) {
		<div class="hush-top">
			<header class="hush-head">
				<h1 class="hush-title">hush</h1>
				<p class="hush-sub">{ title }</p>
			</header>
			<div class="hush-formwrap">
				{ children... }
			</div>
			@backToWall()
		</div>
	}
}

// composePage hosts the WebGPU camera island. It is the dedicated client-JS
// page — a canvas the camera renders into through a WGSL filter pipeline, and
// a capture button that posts the filtered still. The script is an external
// module (CSP: script-src 'self'); the page degrades to the wall's plain
// upload without WebGPU.
templ composePage() {
	@shell("hush — capture") {
		<div class="hush-top">
			<header class="hush-head">
				<h1 class="hush-title">hush</h1>
				<p class="hush-sub">capture something — filtered, on-device.</p>
			</header>
			<div class="hush-cam">
				<canvas id="cam-canvas" class="cam-canvas" width="720" height="720"></canvas>
				<div class="cam-controls">
					<select id="cam-filter" class="cam-filter" aria-label="filter">
						<option value="none">none</option>
						<option value="noir">noir</option>
						<option value="bleach">bleach</option>
						<option value="dream">dream</option>
					</select>
					<button id="cam-shoot" class="hush-post" type="button">capture</button>
				</div>
				<p id="cam-status" class="cam-status" aria-live="polite"></p>
			</div>
			@backToWall()
		</div>
		<script type="module" src="/static/js/camera.js"></script>
	}
}

// applyFormPage is the signup application form: a handle, a password, 3–5
// lines about what you want to post, and an optional photo. Submitting creates
// a pending application an admin reviews.
templ applyFormPage() {
	@formPage("apply to post") {
		<form method="post" action="/apply" enctype="multipart/form-data" class="hush-form">
			<input class="hush-input" type="text" name="handle" placeholder="handle" autocomplete="username" required/>
			<input class="hush-input" type="password" name="password" placeholder="password" autocomplete="new-password" required/>
			<textarea class="hush-input" name="pitch" rows="4" placeholder="what do you want to post? (3–5 lines)" required></textarea>
			<label class="hush-hint">a photo of you (optional)</label>
			<input class="hush-file" type="file" name="photo" accept="image/*"/>
			<div class="hush-form-row">
				<a class="hush-link" href="/login">already approved? sign in →</a>
				<button class="hush-post" type="submit">apply</button>
			</div>
		</form>
	}
}

// loginFormPage is the sign-in form (plain POST → 303). A non-empty errMsg is
// the failed-attempt banner above the form.
templ loginFormPage(errMsg string) {
	@formPage("sign in") {
		if errMsg != "" {
			<p class="hush-note">{ errMsg }</p>
		}
		<form method="post" action="/login" class="hush-form">
			<input class="hush-input" type="text" name="username" placeholder="handle" autocomplete="username" required/>
			<input class="hush-input" type="password" name="password" placeholder="password" autocomplete="current-password" required/>
			<div class="hush-form-row">
				<a class="hush-link" href="/apply">need an account? apply →</a>
				<button class="hush-post" type="submit">sign in</button>
			</div>
		</form>
	}
}

// adminQueuePage lists pending applications with approve/reject controls
// (admin only).
templ adminQueuePage(apps []application) {
	@shell("hush — queue") {
		<div class="hush-top">
			<header class="hush-head">
				<h1 class="hush-title">hush</h1>
				<p class="hush-sub">pending applications</p>
			</header>
			@backToWall()
			for _, ap := range apps {
				@appCard(ap)
			}
			if len(apps) == 0 {
				<p class="hush-sub">nothing pending.</p>
			}
		</div>
	}
}

// appCard is one pending application: the optional photo, the handle, the
// pitch, and the decide buttons.
templ appCard(ap application) {
	{{ id := strconv.FormatInt(ap.ID, 10) }}
	<div class="hush-appcard">
		if ap.PhotoKey != "" {
			<img class="hush-appphoto" src={ "/files/" + ap.PhotoKey } alt=""/>
		}
		<div class="hush-apphandle">{ ap.Handle }</div>
		<div class="hush-apppitch">{ ap.Pitch }</div>
		<div class="hush-form-row">
			@decideForm(id, "reject")
			@decideForm(id, "approve")
		</div>
	</div>
}

// decideForm posts one admin decision (approve or reject) for an application.
templ decideForm(id string, action string) {
	<form method="post" action="/admin/decide">
		<input type="hidden" name="id" value={ id }/>
		<input type="hidden" name="action" value={ action }/>
		if action == "approve" {
			<button class="hush-post" type="submit">approve</button>
		} else {
			<button class="hush-post hush-post--ghost" type="submit">reject</button>
		}
	</form>
}

// note renders the composer's status line. An empty message clears it.
templ note(msg string) {
	{ msg }
}
