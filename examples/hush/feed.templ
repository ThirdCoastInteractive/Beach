// A post's page: the focused card between its time-ordered neighbors, the
// intersect sentinels that extend the feed both ways, and the only two member
// affordances — the thumbs and the quiet flag.
package main

import (
	"strconv"

	"github.com/ThirdCoastInteractive/the-beach/pkg/ui"
)

// feedPage is a post's page: the focused post expanded (just its media, meta,
// and the thumbs — there are no replies; a post stands alone) with its
// time-ordered neighbors around it — newer above, older below, newest-first
// all the way down. Up to feedSpan neighbors render each way; an intersect
// sentinel past each end pulls the next batch as you scroll, so the whole
// timeline is reachable from any post without a single control. The only
// other affordance is the title, which is the way back to the wall — that and
// the browser's own back button.
templ (a *app) feedPage(newer []Post, focused Post, older []Post, moreNewer bool, moreOlder bool, canPost bool, myVote int8, flagState string, handle string, admin bool, tier int) {
	@shell("hush — post #" + strconv.FormatInt(focused.ID, 10)) {
		@accountStrip(handle, admin, tier)
		<header class="hush-head hush-head--feed">
			<h1 class="hush-title"><a class="hush-home" href="/">hush</a></h1>
		</header>
		<div class="hush-feed">
			if moreNewer {
				@moreSentinel("newer", newer[0].ID)
			}
			for _, p := range newer {
				@a.feedCard(p, "hush-above")
			}
			@a.focusedCard(focused, canPost, myVote, flagState)
			for _, p := range older {
				@a.feedCard(p, "hush-below")
			}
			if moreOlder {
				@moreSentinel("older", older[len(older)-1].ID)
			}
		</div>
	}
}

// focusedCard is the expanded post at the center of its feed page: media,
// meta, the thumbs. Nothing else — no thread, no reply box; the wall doesn't
// talk back. Its id is the link fragment that lands the browser here. The
// meta line carries the one moderation affordance members get: the quiet
// flag control — live for members who haven't flagged ("live"), inert once
// they have ("done"), absent on their own posts ("").
templ (a *app) focusedCard(p Post, canPost bool, myVote int8, flagState string) {
	{{ id := strconv.FormatInt(p.ID, 10) }}
	<article id={ "p" + id } class="hush-fcard hush-fcard--focused" style={ vtStyle(p, "") }>
		@cardMedia(p, a.postImageURL(p))
		<div class="hush-card-meta hush-card-meta--focused">
			<span>{ "#" + id + " · " + p.CreatedAt.Format("Jan 2 · 15:04") }</span>
			if flagState == "live" {
				@flagControl(id)
			} else if flagState == "done" {
				@flaggedControl(id)
			}
		</div>
		@reactions(p, canPost, myVote)
	</article>
}

// feedCard is a neighbor in the feed — the post's media and meta, and one rail
// out: the whole card is a link to its own page, where it renders focused.
// Unlike grid tiles, feed cards are named unconditionally: most of them exist
// on the next post's page too, so a feed→feed navigation morphs them to their
// new positions — the feed reads as sliding, not reloading.
templ (a *app) feedCard(p Post, side string) {
	{{ id := strconv.FormatInt(p.ID, 10) }}
	<a id={ "p" + id } class="hush-fcard" style={ vtStyle(p, side) } href={ postHref(p.ID) }>
		@cardMedia(p, a.postImageURL(p))
		<div class="hush-card-meta">
			{ "#" + id + " · " + p.CreatedAt.Format("Jan 2 · 15:04") }
		</div>
	</a>
}

// cardMedia is a post's hero in the feed: the image — imgURL, the
// caller-resolved full-size source (postImageURL) — or the text on the
// post's own computed color.
templ cardMedia(p Post, imgURL string) {
	if p.Kind == "image" {
		<div class="hush-card-media hush-card-media--image">
			<img src={ imgURL } alt=""/>
		</div>
	} else {
		<div class="hush-card-media hush-card-media--text" style={ tileBG(p) }>
			<div class="hush-card-text">
				@templ.Raw(p.BodyHTML)
			</div>
		</div>
	}
}

// moreSentinel is an invisible strip past the feed's last rendered card in
// each direction. When it scrolls into view it fetches the next batch once;
// the batch fragment replaces it (cards plus a fresh sentinel while more
// remain), so the feed extends itself as long as there is timeline left.
templ moreSentinel(dir string, cursor int64) {
	<div id={ "feed-" + dir } class="hush-more" data-on-intersect__once={ moreGet(dir, cursor) }></div>
}

// feedBatch is what a sentinel becomes: the next cards in display order with
// the follow-up sentinel on the outward side, under a display:contents wrapper
// (the patch needs one root; layout never sees it).
templ (a *app) feedBatch(dir string, posts []Post, more bool) {
	<div class="hush-batch">
		if dir == "newer" {
			if more {
				@moreSentinel("newer", posts[0].ID)
			}
			for _, p := range posts {
				@a.feedCard(p, "hush-above")
			}
		} else {
			for _, p := range posts {
				@a.feedCard(p, "hush-below")
			}
			if more {
				@moreSentinel("older", posts[len(posts)-1].ID)
			}
		}
	</div>
}

// reactions is the thumbs control in a focused card. No counts, no ratio —
// scores are hidden everywhere; the only readable state is your own mark
// (your thumb inverts once you've reacted, and the pair goes quiet). The
// fragment IS #vote-<id>, so the vote handler morphs it by id (PatchOuter —
// inner mode would nest #vote-<id> inside itself).
templ reactions(p Post, canPost bool, myVote int8) {
	{{ idStr := strconv.FormatInt(p.ID, 10) }}
	<div id={ "vote-" + idStr } class="hush-react">
		if myVote > 0 {
			<span class="hush-react-btn hush-react-btn--mine">
				@ui.Icon("thumb-up", ui.IconLabel("you liked this"))
			</span>
			<span class="hush-react-btn hush-react-btn--off">
				@ui.Icon("thumb-down")
			</span>
		} else if myVote < 0 {
			<span class="hush-react-btn hush-react-btn--off">
				@ui.Icon("thumb-up")
			</span>
			<span class="hush-react-btn hush-react-btn--mine">
				@ui.Icon("thumb-down", ui.IconLabel("you disliked this"))
			</span>
		} else if canPost {
			<button class="hush-react-btn" data-on:click={ "@post('/p/" + idStr + "/vote?dir=up')" } aria-label="like">
				@ui.Icon("thumb-up")
			</button>
			<button class="hush-react-btn" data-on:click={ "@post('/p/" + idStr + "/vote?dir=down')" } aria-label="dislike">
				@ui.Icon("thumb-down")
			</button>
		} else {
			<span class="hush-react-btn hush-react-btn--off">
				@ui.Icon("thumb-up")
			</span>
			<span class="hush-react-btn hush-react-btn--off">
				@ui.Icon("thumb-down")
			</span>
		}
	</div>
}

// flagControl is the report control: a dim text button in the focused card's
// meta line, members only. No counts, no ceremony — clicking it posts the
// flag and the control comes back as flaggedControl, whatever the flag did.
templ flagControl(id string) {
	<button id={ "flag-" + id } class="hush-flag" data-on:click={ "@post('/p/" + id + "/flag')" }>flag</button>
}

// flaggedControl is flagControl after the click: inert, done. Same id, so the
// flag handler outer-morphs one into the other and a member flags once.
templ flaggedControl(id string) {
	<span id={ "flag-" + id } class="hush-flag hush-flag--done">flagged</span>
}

// hushedCard is what a focused card becomes when flags take its post down
// mid-view: the content is gone, a one-line notice in its place. Same article
// id, so the patch lands where the card stood.
templ hushedCard(id string) {
	<article id={ "p" + id } class="hush-fcard hush-fcard--focused">
		<div class="hush-hushed">hushed.</div>
	</article>
}
